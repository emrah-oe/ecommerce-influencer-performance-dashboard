# Datenbankverbindung für Prisma
# Connection Pooling URL – erforderlich für Dashboard-Laufzeit (lokal + Vercel)
DATABASE_URL=
# Direkte Verbindung – nur für lokale Prisma-CLI / Migrationen (prisma migrate dev)
DIRECT_URL=

# Shopify Admin REST API – nur für lokale Sync-/Seed-Skripte (scripts/)
# Store-Domain ohne https://, z.B. meinshop.myshopify.com
SHOPIFY_STORE_DOMAIN=meinshop.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-04
