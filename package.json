{
  "name": "shopify-influencer-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "tsx scripts/generate-orders.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import:synthetic": "tsx scripts/import-synthetic.ts",
    "check:db": "tsx scripts/check-db.ts",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "seed:influencers": "tsx scripts/seed-influencers.ts",
    "sync:shopify": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/run-sync.ts",
    "seed:shopify": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/shopify-seed-orders.ts",
    "seed:shopify-influencers": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/seed-shopify-influencers.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "^14.2.35",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  }
}
